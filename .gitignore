# 各ディレクトリ共通の除外設定

# dx フォルダの設定
dx/_vendor/
dx/downloadpdf/
dx/libs/*
!dx/libs/templates/
dx/mpdf-development/
dx/pdf/mpdf/
dx/pdf/mpdf-test/
dx/pdf/tcpdf-set/
dx/PHPMailer/
dx/vendor/

# dxdev フォルダの設定
dxdev/_vendor/
dxdev/downloadpdf/
dxdev/libs/*
!dxdev/libs/templates/
dxdev/mpdf-development/
dxdev/pdf/mpdf/
dxdev/pdf/mpdf-test/
dxdev/pdf/tcpdf-set/
dxdev/PHPMailer/
dxdev/vendor/

